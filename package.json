{
  "name": "mdx-forge",
  "version": "0.10.1",
  "packageManager": "npm@11.17.0",
  "description": "Unified MDX runtime toolkit — compiler, browser module loader & framework component shims",
  "type": "module",
  "license": "MIT",
  "author": "Garrett Fincke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggfincke/mdx-forge.git"
  },
  "bugs": {
    "url": "https://github.com/ggfincke/mdx-forge/issues"
  },
  "homepage": "https://github.com/ggfincke/mdx-forge#readme",
  "keywords": [
    "mdx",
    "compiler",
    "react",
    "components",
    "docusaurus",
    "starlight",
    "nextra",
    "shiki"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./compiler": {
      "import": "./dist/esm/compiler/index.js",
      "types": "./dist/types/compiler/index.d.ts"
    },
    "./compiler/plugins": {
      "import": "./dist/esm/compiler/plugins/index.js",
      "types": "./dist/types/compiler/plugins/index.d.ts"
    },
    "./diagnostics": {
      "import": "./dist/esm/diagnostics/index.js",
      "types": "./dist/types/diagnostics/index.d.ts"
    },
    "./diagnostics/analyze": {
      "import": "./dist/esm/diagnostics/analyze/index.js",
      "types": "./dist/types/diagnostics/analyze/index.d.ts"
    },
    "./browser": {
      "import": "./dist/esm/browser/index.js",
      "types": "./dist/types/browser/index.d.ts"
    },
    "./browser/registry": {
      "import": "./dist/esm/browser/registry/index.js",
      "types": "./dist/types/browser/registry/index.d.ts"
    },
    "./components": {
      "import": "./dist/esm/components/index.js",
      "types": "./dist/types/components/index.d.ts"
    },
    "./components/generic": {
      "import": "./dist/esm/components/generic/index.js",
      "types": "./dist/types/components/generic/index.d.ts"
    },
    "./components/docusaurus": {
      "import": "./dist/esm/components/docusaurus/index.js",
      "types": "./dist/types/components/docusaurus/index.d.ts"
    },
    "./components/starlight": {
      "import": "./dist/esm/components/starlight/index.js",
      "types": "./dist/types/components/starlight/index.d.ts"
    },
    "./components/nextra": {
      "import": "./dist/esm/components/nextra/index.js",
      "types": "./dist/types/components/nextra/index.d.ts"
    },
    "./components/nextjs": {
      "import": "./dist/esm/components/nextjs/index.js",
      "types": "./dist/types/components/nextjs/index.d.ts"
    },
    "./components/registry": {
      "import": "./dist/esm/components/registry/index.js",
      "types": "./dist/types/components/registry/index.d.ts"
    },
    "./components/styles/generic.css": "./dist/components/styles/generic.css",
    "./components/styles/docusaurus.css": "./dist/components/styles/docusaurus.css",
    "./components/styles/starlight.css": "./dist/components/styles/starlight.css",
    "./components/styles/nextra.css": "./dist/components/styles/nextra.css",
    "./components/styles/nextjs.css": "./dist/components/styles/nextjs.css",
    "./components/styles/tokens.css": "./dist/components/styles/tokens.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.0.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-brace-style": "^0.10.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/fix-esm-import-specifiers.mjs && node ./scripts/copy-css.mjs",
    "check:esm-specifiers": "node ./scripts/fix-esm-import-specifiers.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:dev": "tsc -p dev/tsconfig.json --noEmit",
    "check:consumers": "node ./scripts/consumer-matrix.mjs",
    "check:plugin-compat": "node ./scripts/plugin-compat.mjs",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint . && npm run check:guardrails",
    "lint:fix": "eslint . --fix && npm run check:guardrails",
    "check:legacy-paths": "node ./scripts/check-legacy-path-prefixes.mjs",
    "check:guardrails": "npm run check:legacy-paths && npm run check:frontmatter-imports",
    "check:frontmatter-imports": "node ./scripts/check-frontmatter-imports.mjs",
    "format": "prettier --write . && npm run lint:fix",
    "format:check": "prettier --check . && npm run lint",
    "dev": "vite --config dev/vite.config.ts",
    "prepublishOnly": "npm run build && npm run check:esm-specifiers",
    "version": "node scripts/check-changelog.mjs && git add CHANGELOG.md",
    "prepare": "husky"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-brace-style"
    ],
    "braceStyle": "allman",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 80,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
