{
  "name": "@mdx-forge/render-plugin",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@11.17.0",
  "description": "MCP server that renders MDX to HTML plus optional headless Chromium screenshot. Exposes list_components & render_mdx w/ structured diagnostics (prop lint, frontmatter validation, did-you-mean suggestions).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-harness.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.harness.json --noEmit",
    "start": "node dist/server.js",
    "smoke": "npm run build && npm run smoke:diagnostics && npm run smoke:trusted-errors && npm run smoke:safe && npm run smoke:trusted && npm run smoke:boundary && npm run smoke:diagrams",
    "smoke:diagnostics": "node scripts/smoke-diagnostics.mjs",
    "smoke:diagrams": "node scripts/smoke-diagrams.mjs",
    "smoke:trusted-errors": "node scripts/smoke-trusted-errors.mjs",
    "smoke:safe": "node scripts/smoke.mjs",
    "smoke:trusted": "node scripts/smoke-trusted.mjs",
    "smoke:boundary": "node scripts/smoke-boundary.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "^0.28.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mdx-forge": "^0.10.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
